# Copy to .env locally, or add these variables to the Render backend service.
# For Render-to-Railway connections, use Railway's public TCP proxy host and port.
NODE_ENV=production
PORT=5000
API_URL=https://kamulicu.onrender.com
CORS_ORIGINS=https://kamuli-cu.vercel.app,http://localhost:5173,http://localhost:3000

# Railway MySQL credentials; use the public endpoint when the backend is on Render.
MYSQLHOST=replace_with_railway_public_host
MYSQLPORT=replace_with_railway_public_port
MYSQLUSER=replace_with_railway_mysql_user
MYSQLPASSWORD=replace_with_railway_mysql_password
MYSQLDATABASE=replace_with_railway_mysql_database

# Optional DB_* aliases override MYSQL* when provided.
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_PORT=

JWT_SECRET=
JWT_EXPIRE=7d

# Optional: configure Cloudinary for persistent book covers and digital objects.
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: Gmail credentials for transactional email.
EMAIL_USER=
EMAIL_PASSWORD=